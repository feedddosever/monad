# Compiler files
cache/
out/

# Ignores development broadcast logs
# (non-local broadcasts are kept: they record deployment tx hashes for the submission)
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Dotenv files: never commit secrets, only the examples
.env
.env.*
!.env.example

# Keys and keystores
*.pem
*.key
keystore/
keystores/

# Node / Next.js (app/.gitignore covers the rest)
node_modules/
.next/

# OS / editor
.DS_Store
.idea/
