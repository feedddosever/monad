# Copy to .env (git-ignored). Foundry loads it automatically. Never commit real values.
# Frontend variables live in app/.env.example.

# Deployer: name of an encrypted Foundry keystore in ~/.foundry/keystores, used as --account.
# Create one with: cast wallet import monad-deployer --interactive
# Do NOT put a raw private key in this file.
ETH_KEYSTORE_ACCOUNT=monad-deployer

# Optional: Monadscan (Etherscan v2) API key, only needed for `forge verify-contract --verifier etherscan`.
# Sourcify verification via MonadVision needs no key.
ETHERSCAN_API_KEY=
