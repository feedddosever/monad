# Copy to .env (git-ignored). Foundry loads it automatically. Never commit real values.
# Frontend variables live in app/.env.example.

# Signer, option A (used by scripts/deploy-testnet.sh and scripts/seed-demo.sh): a throwaway, testnet-only
# key funded with a few MON. The scripts read it with vm.envUint and never print it. Never commit .env.
PRIVATE_KEY=

# Signer, option B: an encrypted Foundry keystore (cast wallet import monad-deployer --interactive).
# Leave this commented out when PRIVATE_KEY is set.
# ETH_KEYSTORE_ACCOUNT=monad-deployer

# Deploy settings (script/Deploy.s.sol). All optional.
# Address whose EIP-712 signatures CreditRegistry accepts for wallet-age attestations (default: deployer).
ATTESTOR_ADDRESS=
# Protocol seconds per real second: 43200 = demo clock (30-day loan lasts 60 s); use 1 on mainnet.
TIME_SCALE=43200

# Optional: Monadscan (Etherscan v2) API key, only needed for `forge verify-contract --verifier etherscan`.
# Sourcify verification via MonadVision needs no key.
ETHERSCAN_API_KEY=
